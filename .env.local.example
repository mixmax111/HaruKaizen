# ─────────────────────────────────────────────────────────────────────────────
# 🌸 HaruKaizen — Local Edition Environment Template (.env.local.example)
# ─────────────────────────────────────────────────────────────────────────────
# Architettura: Self-Hosted, Local-Only & Air-Gapped (LAN domestica / Ufficio)
# 
# ISTRUZIONI RAPIDE:
# 1. Copia questo file in .env alla radice del monorepo:
#    cp .env.local.example .env (oppure copy .env.local.example .env su Windows)
# 2. Sostituisci <YOUR_LOCAL_IP> con l'IP locale del tuo PC sulla rete Wi-Fi/Ethernet:
#    - Windows: esegui "ipconfig" e leggi "Indirizzo IPv4" (es. 192.168.1.150)
#    - macOS / Linux: esegui "ifconfig" o "ip a" (es. 192.168.1.150)
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# 1. RETE & URL PUBBLICI (LAN / Dispositivi Mobile)
# =============================================================================
# Per test su smartphone fisico o altri dispositivi della rete locale,
# sostituisci "localhost" con l'IP del tuo computer (es. http://192.168.1.150:8080/api/v1)
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# Origine frontend autorizzata per le policy CORS di NestJS
# Consente sia localhost sia subnet tipiche LAN (192.168.x.x, 10.x.x.x)
WEB_ORIGIN="http://localhost:3000"

# Porte host per il deployment locale
WEB_PORT=3000
API_PORT=8080

# =============================================================================
# 2. DATABASE POSTGRESQL & CACHE REDIS
# =============================================================================
# Credenziali per il container PostgreSQL locale
POSTGRES_USER=harukaizen
POSTGRES_PASSWORD=harukaizen_local_secret
POSTGRES_DB=harukaizen_db
POSTGRES_PORT=5432

# Stringa di connessione Prisma (PostgreSQL 17 locale)
DATABASE_URL="postgresql://harukaizen:harukaizen_local_secret@localhost:5432/harukaizen_db?schema=public"

# Connessione Redis locale per rate limiting e caching
REDIS_URL="redis://localhost:6379"

# =============================================================================
# 3. CRITTOGRAFIA & SICUREZZA AUTH (Local Sovereign)
# =============================================================================
# Segreti JWT per la generazione e verifica dei token operatore (minimo 32 caratteri)
JWT_SECRET="harukaizen_super_secure_local_jwt_secret_minimum_32_chars_2026"
JWT_REFRESH_SECRET="harukaizen_super_secure_local_refresh_secret_minimum_32_chars_2026"

# Chiave crittografica AES-256-GCM (esattamente 64 caratteri esadecimali / 32 byte)
# Utilizzata da NestJS per cifrare a riposo le credenziali salvate nel database
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Chiave HMAC per la firma delle sfide crittografiche Proof-of-Work Altcha
ALTCHA_HMAC_KEY="harukaizen_local_altcha_hmac_secret_key_32_chars_2026"

# =============================================================================
# 4. CONFIGURAZIONE MOBILE (Expo SDK 52)
# =============================================================================
# Usato dall'app mobile React Native quando compilata o avviata con Metro.
# Sostituisci con l'IP del tuo computer se usi un telefono fisico con Expo Go:
EXPO_PUBLIC_API_URL="http://localhost:8080/api/v1"

