{
  "name": "harukaizen-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:mobile": "npm start --workspace=mobile",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@harukaizen/shared": "*",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.0.0",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "ai": "^7.0.127",
    "axios": "^1.20.0",
    "cache-manager": "^7.2.9",
    "dotenv": "^18.0.5",
    "keyv": "^5.6.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1"
  }
}
