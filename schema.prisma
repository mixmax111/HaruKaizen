generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "typedSql", "relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// UTENTI & AUTENTICAZIONE
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?   @map("password_hash")
  firebaseUid         String?   @map("firebase_uid")
  authProvider        String    @map("auth_provider")
  role                String    @default("USER")        // "USER" | "ADMIN"
  dietTrackingMode    Int       @default(0) @map("diet_tracking_mode")
  lifestyleMultiplier Float     @default(1.2) @map("lifestyle_multiplier")

  // Dati biologici per calcolo TDEE (formula Mifflin-St Jeor)
  heightCm            Float?    @map("height_cm")
  birthDate           DateTime? @map("birth_date") @db.Date
  sex                 String?   // "M" | "F"

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  userSettings       UserSettings?
  measurements       Measurement[]
  progressMedia      ProgressMedia[]
  aiInsightReports   AiInsightReport[]
  createdExercises   Exercise[]
  workoutPlans       WorkoutPlan[]
  workoutLogs        WorkoutLog[]
  dietPlans          DietPlan[]
  nutritionLogs      NutritionLog[]

  @@map("users")
}

model UserSettings {
  id                   String   @id @default(uuid())
  userId               String   @unique @map("user_id")

  // Chiave API LLM criptata in AES-256-GCM (mai in chiaro nel DB)
  llmApiKey            String?  @map("llm_api_key")
  preferredLlmProvider String?  @map("preferred_llm_provider") // "openai" | "anthropic"
  timezone             String   @default("Europe/Rome")
  locale               String   @default("it-IT")
  fcmPushToken         String?  @map("fcm_push_token")
  targetWeightKg       Float?   @map("target_weight_kg")
  coachTone            String   @default("KAIZEN") @map("coach_tone") // "RIGOROUS" | "EMPATHETIC" | "KAIZEN"
  isDarkMode           Boolean  @default(true) @map("is_dark_mode")

  updatedAt            DateTime @updatedAt @map("updated_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// MISURAZIONI & PROGRESSI
// ─────────────────────────────────────────────────────────────────────────────

model Measurement {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")

  weightKg          Float     @map("weight_kg")
  bodyFatPercentage Float?    @map("body_fat_percentage")
  chestCm           Float?    @map("chest_cm")
  armsCm            Float?    @map("arms_cm")
  waistCm           Float?    @map("waist_cm")
  legsCm            Float?    @map("legs_cm")

  recordedAt        DateTime  @map("recorded_at") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  user              User      @relation(fields: [userId], references: [id])

  @@map("measurements")
}

model ProgressMedia {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  mediaUrl    String    @map("media_url")
  mediaType   String    @map("media_type") // "image" | "video"

  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User      @relation(fields: [userId], references: [id])

  @@map("progress_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI REPORTS
// ─────────────────────────────────────────────────────────────────────────────

model AiInsightReport {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")

  timeframeCode      String    @map("timeframe_code")
  dateStart          DateTime  @map("date_start") @db.Date
  dateEnd            DateTime  @map("date_end") @db.Date
  contextSnapshot    String    @map("context_snapshot") @db.Text
  aiResponseMarkdown String    @map("ai_response_markdown") @db.Text
  reportType         String    @map("report_type") // "WEEKLY" | "MONTHLY" | "ON_DEMAND"

  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  user               User      @relation(fields: [userId], references: [id])

  @@map("ai_insight_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// ALLENAMENTO
// ─────────────────────────────────────────────────────────────────────────────

model Exercise {
  id                 String    @id @default(uuid())
  name               String
  category           String    // ExerciseCategory enum: CHEST | BACK | LEGS | SHOULDERS | ARMS | CORE | CARDIO
  equipment          String?
  defaultMetValue    Float     @map("default_met_value")
  createdByUserId    String?   @map("created_by_user_id")
  isVerified         Boolean   @default(false) @map("is_verified")

  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  createdByUser      User?     @relation(fields: [createdByUserId], references: [id])
  workoutDayExercises WorkoutDayExercise[]

  @@map("exercises")
}

model WorkoutPlan {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  isActive    Boolean   @default(true) @map("is_active")
  isPublic    Boolean   @default(false) @map("is_public")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User      @relation(fields: [userId], references: [id])
  workoutDays WorkoutDay[]

  @@map("workout_plans")
}

model WorkoutDay {
  id            String    @id @default(uuid())
  workoutPlanId String    @map("workout_plan_id")
  name          String
  orderIndex    Int       @map("order_index")

  workoutPlan   WorkoutPlan        @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises     WorkoutDayExercise[]

  @@map("workout_days")
}

model WorkoutDayExercise {
  id            String    @id @default(uuid())
  workoutDayId  String    @map("workout_day_id")
  exerciseId    String    @map("exercise_id")
  orderIndex    Int       @map("order_index")
  sets          Int
  repsTarget    String    @map("reps_target")  // es. "8-12" o "AMRAP"
  weightTarget  String?   @map("weight_target") // es. "80kg" o "RPE 8"
  restSeconds   Int       @map("rest_seconds")
  notes         String?

  workoutDay    WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise      Exercise   @relation(fields: [exerciseId], references: [id])

  @@map("workout_day_exercises")
}

model WorkoutLog {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  dayNameSnapshot  String    @map("day_name_snapshot") // Nome del giorno al momento dell'esecuzione

  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  durationMinutes  Int?      @map("duration_minutes")
  caloriesBurned   Float?    @map("calories_burned")

  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  user             User      @relation(fields: [userId], references: [id])
  logExercises     WorkoutLogExercise[]

  @@map("workout_logs")
}

model WorkoutLogExercise {
  id                     String    @id @default(uuid())
  workoutLogId           String    @map("workout_log_id")
  exerciseNameSnapshot   String    @map("exercise_name_snapshot") // Nome esercizio al momento del log
  isSkipped              Boolean   @default(false) @map("is_skipped")
  notes                  String?

  workoutLog             WorkoutLog  @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  logSets                WorkoutLogSet[]

  @@map("workout_log_exercises")
}

// Dati granulari per-set: necessari per calcolo progressive overload lato AI
model WorkoutLogSet {
  id                    String   @id @default(uuid())
  workoutLogExerciseId  String   @map("workout_log_exercise_id")
  orderIndex            Int      @map("order_index")    // Ordine della serie (1, 2, 3...)
  setType               String   @map("set_type")       // "WORKING" | "WARMUP" | "DROP" | "FAILURE"
  repsCompleted         Int?     @map("reps_completed") // null = serie a cedimento (AMRAP)
  weightKg              Float?   @map("weight_kg")      // null = esercizio a corpo libero
  rpe                   Float?                          // Rate of Perceived Exertion 1-10 (opzionale)
  notes                 String?

  logExercise           WorkoutLogExercise @relation(fields: [workoutLogExerciseId], references: [id], onDelete: Cascade)

  @@map("workout_log_sets")
}

// ─────────────────────────────────────────────────────────────────────────────
// NUTRIZIONE
// ─────────────────────────────────────────────────────────────────────────────

model FoodItem {
  id             String    @id @default(uuid())
  name           String
  barcode        String?   @unique // Univoco per evitare duplicati da OpenFoodFacts
  calories100g   Float     @map("calories_100g")
  protein100g    Float     @map("protein_100g")
  carbs100g      Float     @map("carbs_100g")
  fat100g        Float     @map("fat_100g")
  fiber100g      Float?    @map("fiber_100g")
  sodium100g     Float?    @map("sodium_100g")
  isVerified     Boolean   @default(false) @map("is_verified")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  dietDayItems   DietDayItem[]
  nutritionLogs  NutritionLog[]

  @@map("food_items")
}

model DietPlan {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  isActive    Boolean   @default(true) @map("is_active")
  isPublic    Boolean   @default(false) @map("is_public")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user        User      @relation(fields: [userId], references: [id])
  dietDays    DietDay[]

  @@map("diet_plans")
}

model DietDay {
  id          String    @id @default(uuid())
  dietPlanId  String    @map("diet_plan_id")
  name        String

  dietPlan    DietPlan  @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  dietDayItems DietDayItem[]

  @@map("diet_days")
}

model DietDayItem {
  id            String    @id @default(uuid())
  dietDayId     String    @map("diet_day_id")
  foodItemId    String    @map("food_item_id")

  scheduledTime String?   @map("scheduled_time") // es. "08:00"
  mealType      String    @map("meal_type")       // "BREAKFAST" | "LUNCH" | "DINNER" | "SNACK"
  quantityG     Float     @map("quantity_g")

  dietDay       DietDay   @relation(fields: [dietDayId], references: [id], onDelete: Cascade)
  foodItem      FoodItem  @relation(fields: [foodItemId], references: [id])

  @@map("diet_day_items")
}

model NutritionLog {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  foodItemId        String?   @map("food_item_id")

  loggedAt          DateTime  @map("logged_at")
  mealType          String    @map("meal_type") // "BREAKFAST" | "LUNCH" | "DINNER" | "SNACK"
  customFoodName    String?   @map("custom_food_name") // Per alimenti non in DB
  quantityG         Float     @map("quantity_g")

  // Valori calcolati al momento del log (snapshot dei macro)
  caloriesConsumed  Float     @map("calories_consumed")
  proteinConsumed   Float?    @map("protein_consumed")
  carbsConsumed     Float?    @map("carbs_consumed")
  fatConsumed       Float?    @map("fat_consumed")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  user              User      @relation(fields: [userId], references: [id])
  foodItem          FoodItem? @relation(fields: [foodItemId], references: [id])

  @@map("nutrition_logs")
}