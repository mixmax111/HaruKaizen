# URL dell'API NestJS (porta 8002 esposta su host da hk-api-local Docker per evitare collisioni Windows su 8080)
# Se lasciata vuota o se impostata su localhost in DEV, l'app rileva automaticamente l'IP LAN dell'host Metro
# SU EMULATORE ANDROID: http://10.0.2.2:8002/api/v1
# SU SMARTPHONE FISICO: http://<LAN_IP>:8002/api/v1 (es. http://192.168.1.6:8002/api/v1)
EXPO_PUBLIC_API_URL="http://localhost:8002/api/v1"
