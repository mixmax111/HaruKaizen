# ─────────────────────────────────────────────────────────────────────────────
# 🧠 HaruKaizen API — Environment Configuration (NestJS)
# ─────────────────────────────────────────────────────────────────────────────

# Porta su cui ascolta il server API (8002 in Local-Edition)
PORT=8002

# Stringa di connessione PostgreSQL (porta 5433 per evitare conflitti con PostgreSQL locale)
DATABASE_URL="postgresql://harukaizen:harukaizen_local_secret@localhost:5433/harukaizen_db?schema=public"

# Istanza Redis per Rate Limiting distribuito e caching
REDIS_URL="redis://localhost:6379"

# Origine frontend principale consentita per le policy CORS
WEB_ORIGIN="http://localhost:3000"

# Segreti Crittografici JWT (minimo 32 caratteri ciascuno)
JWT_SECRET="harukaizen_super_secure_local_jwt_secret_minimum_32_chars_2026"
JWT_REFRESH_SECRET="harukaizen_super_secure_local_refresh_secret_minimum_32_chars_2026"

# Chiave di cifratura AES-256-GCM (esattamente 64 caratteri esadecimali / 32 byte)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Chiave HMAC Altcha
ALTCHA_HMAC_KEY="harukaizen_local_altcha_hmac_secret_key_32_chars_2026"
