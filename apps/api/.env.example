# ─────────────────────────────────────────────────────────────────────────────
# 🧠 HaruKaizen API — Environment Configuration (NestJS)
# ─────────────────────────────────────────────────────────────────────────────

# Porta su cui ascolta il server API
PORT=3000

# Stringa di connessione PostgreSQL
DATABASE_URL="postgresql://harukaizen:harukaizen_secret@localhost:5433/harukaizen_db?schema=public"

# Istanza Redis per Rate Limiting distribuito e caching
REDIS_URL="redis://localhost:6379"

# Origine frontend consentita per le policy CORS
WEB_ORIGIN="http://localhost:3001"

# Segreti Crittografici JWT (minimo 32 caratteri ciascuno)
JWT_SECRET="harukaizen_super_secure_jwt_secret_key_minimum_32_chars_2026"
JWT_REFRESH_SECRET="harukaizen_super_secure_jwt_refresh_secret_key_minimum_32_chars_2026"

# Chiave di cifratura AES-256-GCM (esattamente 64 caratteri esadecimali / 32 byte)
# Usata per criptare le API key LLM degli utenti nel database
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
