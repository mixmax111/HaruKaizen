# ─────────────────────────────────────────────────────────────────────────────
# 🌸 HaruKaizen — Root Environment Configuration
# Usato da Prisma ORM, script di seeding e Docker Compose
# ─────────────────────────────────────────────────────────────────────────────

# Connessione al database PostgreSQL (porta 5433 per evitare conflitti su macchine Windows/Linux)
DATABASE_URL="postgresql://harukaizen:harukaizen_secret@localhost:5433/harukaizen_db?schema=public"

# Connessione Redis (usato per rate limiting distribuito e caching)
REDIS_URL="redis://localhost:6379"

# Credenziali Postgres per Docker Compose
POSTGRES_USER=harukaizen
POSTGRES_PASSWORD=harukaizen_secret
POSTGRES_DB=harukaizen_db
POSTGRES_PORT=5433
