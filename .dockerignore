# Dependencies
# ─────────────────────────────────────────────────────────────────────────────
# 🐳 HaruKaizen — Docker Ignore Configuration (Ultra-Fast Build Context)
# ─────────────────────────────────────────────────────────────────────────────

# Ignora tutte le cartelle node_modules a qualsiasi profondità
**/node_modules
node_modules
*/node_modules
*/*/node_modules

# Build outputs
# Ignora tutti gli output di build locali (es. 400+ MB di .next compilato su host)
**/.next
.next
**/dist
dist
**/build
build
**/out
out
**/.turbo
.turbo
**/.cache
.cache
**/.expo
.expo
.cache

# Mobile specific
apps/mobile/android
apps/mobile/ios
# Ignora l'applicazione mobile (non necessaria nei container Web & API)
apps/mobile
apps/mobile/**

# Version control
# Ignora file di controllo versione e documentazione pesante
.git
.gitignore
.github
html
html/**
sviluppo doc
sviluppo doc/**
*.md

# Environment variables
# Ignora cartelle di upload locali e backup DB
uploads
uploads/**
backups
backups/**
*.sql
*.sql.gz
*.dump

# File di ambiente locali e segreti
.env
.env.local
.env.*.local
*.env
**/*.env
**/*.env.*
!.env.example
!**/.env.example

# Logs and debug
# File temporanei, logs e OS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.tmp
Thumbs.db